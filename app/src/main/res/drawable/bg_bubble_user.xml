<?xml version="1.0" encoding="utf-8"?>
<!--
    The user's bubble. Blue, and with the bottom-right corner drawn tighter than the rest
    so the bubble reads as pointing at the edge it is pushed against - the same trick the
    reference uses for its tail, without needing a custom path.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/bubble_user" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="16dp"
        android:bottomRightRadius="4dp" />
</shape>
