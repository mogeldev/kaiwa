<?xml version="1.0" encoding="utf-8"?>
<!--
    A chat list row: transparent at rest, tinted the moment the D-pad lands on it.

    The highlight has to live here rather than on the list's selector, because each row
    now contains a focusable Delete - and a ListView stops drawing its selector once its
    items can take focus themselves.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/list_selector" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/list_selector" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
