<?xml version="1.0" encoding="utf-8"?>
<!--
    About: its own screen rather than a block at the foot of the settings form, because
    nothing on it can be changed and a form is for things that can.

    Same header as the other submenus - a Back button and a title, as ordinary views - and
    the same dark palette. The Back button is the only focusable thing here, so it takes
    focus on the way in and Center leaves.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kaiwa_bg"
    android:orientation="vertical">

    <!--
        Wraps rather than control_height: SystemBars adds the status bar inset as top padding,
        and a fixed height has nowhere to grow - the Back chip would be pushed out of the header.
        The chip inside is control_height tall, so wrapping lands on the same height as before
        wherever there is no inset to add.
    -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="14dp">

        <Button
            android:id="@+id/buttonBack"
            style="@style/Kaiwa.Button.Back"
            android:text="@string/action_back">

            <requestFocus />
        </Button>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/about_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/textAboutVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/about_body"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
