<?xml version="1.0" encoding="utf-8"?>
<!--
    First run only. Deliberately small: a greeting, then the two ways out - import a
    config file, or type a key in by hand.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kaiwa_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.01"
            android:text="@string/welcome_hello_title"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/welcome_hello"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/buttonImport"
            style="@style/Kaiwa.Button"
            android:layout_marginTop="26dp"
            android:text="@string/welcome_import">

            <requestFocus />
        </Button>

        <Button
            android:id="@+id/buttonSettings"
            style="@style/Kaiwa.Button"
            android:text="@string/welcome_settings" />

        <TextView
            android:id="@+id/textWelcomeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
