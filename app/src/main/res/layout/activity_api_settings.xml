<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kaiwa_bg"
    android:orientation="vertical">

    <!--
        This screen's own header: a Back button and a title, as ordinary views rather than
        an action bar. An action bar's up arrow would be the conventional place for it, but
        action-bar items cannot take focus on a screen the platform considers touch-capable,
        and a Back button the keypad cannot reach is no way out at all.
    -->
    <!--
        Wraps rather than control_height: SystemBars adds the status bar inset as top padding,
        and a fixed height has nowhere to grow - the Back chip would be pushed out of the header.
        The chip inside is control_height tall, so wrapping lands on the same height as before
        wherever there is no inset to add.
    -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="14dp">

        <Button
            android:id="@+id/buttonBack"
            style="@style/Kaiwa.Button.Back"
            android:text="@string/action_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/api_settings_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollSettings"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                style="@style/Kaiwa.FieldLabel"
                android:text="@string/label_api_key" />

            <EditText
                android:id="@+id/editApiKey"
                style="@style/Kaiwa.Field"
                android:hint="@string/hint_api_key"
                android:inputType="textPassword">

                <requestFocus />
            </EditText>

            <TextView
                style="@style/Kaiwa.FieldLabel"
                android:text="@string/label_base_url" />

            <EditText
                android:id="@+id/editBaseUrl"
                style="@style/Kaiwa.Field"
                android:hint="@string/hint_base_url"
                android:inputType="textUri" />

            <TextView
                style="@style/Kaiwa.FieldLabel"
                android:text="@string/label_model" />

            <EditText
                android:id="@+id/editModel"
                style="@style/Kaiwa.Field"
                android:hint="@string/hint_model"
                android:inputType="text" />

            <TextView
                style="@style/Kaiwa.FieldLabel"
                android:text="@string/label_system_prompt" />

            <EditText
                android:id="@+id/editSystemPrompt"
                style="@style/Kaiwa.Field"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3" />

            <!--
                Test connection sits close to the last field: everything on this screen has
                to fit 511dp without scrolling, and the spacing is where the room came from.
            -->
            <Button
                android:id="@+id/buttonTest"
                style="@style/Kaiwa.Button"
                android:layout_marginTop="10dp"
                android:text="@string/action_test" />

            <Button
                android:id="@+id/buttonSave"
                style="@style/Kaiwa.Button"
                android:layout_marginTop="8dp"
                android:text="@string/action_save" />

            <TextView
                android:id="@+id/textStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
