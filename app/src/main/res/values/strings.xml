<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Kaiwa</string>

    <!--
        The transcript has no speaker labels any more: a bubble's side and colour say who
        is talking, so the only strings left here belong to states rather than to people.
    -->
    <string name="thinking">Thinking\u2026</string>

    <string name="hint_input">Type a message\u2026</string>
    <string name="action_send">\u25B6</string>
    <string name="sending">\u2026</string>
    <string name="empty_state">No messages yet.\nType below, then press the Send key.</string>
    <string name="need_api_key">Set your API key first.</string>

    <string name="settings_title">Settings</string>
    <string name="api_settings_title">API settings</string>
    <!--
        The chat screen's own controls are symbols, not words: the right-hand column is
        44dp wide, and "Send" wrapped onto two lines at the width it used to be. Geometric
        shapes came out fine on the device already (the scroll arrows). The submenus label
        themselves with words, because they have the width for them.
    -->
    <string name="action_chats">\uD83D\uDCAC</string>
    <string name="action_new_chat">+</string>
    <string name="chat_list_title">Chats</string>
    <string name="action_delete">Delete</string>
    <!--
        The way out of a submenu: the arrow alone, in a chip the size of one sidebar
        control. The title beside it already names the screen, and a word would have spent
        that chip's width saying what the arrow already says.
    -->
    <string name="action_back">\u25C0</string>
    <string name="delete_chat_title">Delete chat?</string>
    <string name="delete_chat_message">Delete \"%1$s\"?\nThis cannot be undone.</string>
    <string name="chat_deleted">Chat deleted.</string>
    <string name="scroll_up">\u25B2</string>
    <string name="scroll_down">\u25BC</string>
    <!--
        A gear, for Settings. It was an overflow (three dots) opening a popup menu, and it
        is neither of those things now: the gear opens a screen, and the name says so.
    -->
    <string name="action_settings">\u2699</string>
    <!--
        Voice input. The labels are symbols for the same reason as the rest: the
        right-hand column is narrow. The stop glyph is a geometric shape (U+25A0)
        rather than a media-control emoji, because the geometric shapes are the ones
        already proven to render on this handset.
    -->
    <string name="mic">\uD83C\uDFA4</string>
    <string name="mic_stop">\u25A0</string>
    <string name="transcribing">Transcribing\u2026</string>
    <string name="hint_recording">Recording\u2026 press \u25A0 to stop.</string>
    <string name="mic_denied">Voice input needs microphone access.</string>
    <string name="mic_not_configured">Voice input is not set up. Add a \"transcribe\" section to your config file.</string>
    <string name="mic_not_configured_cloud">Voice input is set to \"cloud\", but \"transcribeCloud\" is not set up in your config file.</string>
    <string name="mic_failed">Could not start recording:\n%1$s</string>
    <string name="mic_nothing_recorded">Nothing was recorded.</string>
    <string name="mic_nothing_transcribed">No speech was recognised. Try again.</string>
    <string name="import_config">Import config\u2026</string>
    <string name="import_cancelled">Import cancelled.</string>
    <string name="action_save">Save</string>
    <string name="action_test">Test connection</string>
    <string name="testing">Testing\u2026</string>
    <string name="test_failed">Failed:\n%1$s</string>
    <string name="invalid_base_url">The Base URL has to start with https:// or http://, so it was not saved.</string>

    <!--
        First run. The app deliberately does not open onto Settings: on this handset the
        point of the config import is that no key has to be typed.
    -->
    <string name="welcome_hello_title">Hello.</string>
    <string name="welcome_hello">Kaiwa needs to know which AI service to talk to. Import your config file to set that up: the file carries the API key, the server and the model, so nothing has to be typed on the keypad.</string>
    <string name="welcome_import">Import config file\u2026</string>
    <string name="welcome_settings">Enter settings manually</string>
    <string name="welcome_still_unconfigured">Still no API key, so Kaiwa cannot send anything yet. Import a config file that has one, or enter it in Settings.</string>

    <string name="label_api_key">API key</string>
    <string name="hint_api_key">sk-\u2026</string>
    <string name="label_base_url">Base URL</string>
    <string name="hint_base_url">https://api.deepseek.com</string>
    <string name="label_model">Model</string>
    <string name="hint_model">deepseek-flash</string>
    <string name="label_system_prompt">System prompt</string>

    <!--
        About, a submenu of its own. The version is filled in from the build rather than
        typed here, so the one line on that screen that could go stale cannot.
    -->
    <string name="action_about">About</string>
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_body">A small chat client for the phone in your pocket, built for one without a touchscreen: the D-pad reaches every control, and replies arrive whole rather than streaming in.\n\nKaiwa talks to any OpenAI-compatible service, and keeps a chat and its settings in plain files on the device.</string>
</resources>
