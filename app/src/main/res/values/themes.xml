<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark throughout, and not DayNight: every screen draws its own colours, so there is
        nothing here that would improve by following the system between light and dark.

        There are no action bars anywhere. Each screen that needs a header draws one, for a
        reason worth recording: an action bar's items - including its up arrow - cannot take
        focus on a screen the platform considers touch-capable, and a Back button the keypad
        cannot reach is not a Back button. Ordinary views in the content have no such
        trouble, which is also why the chat screen's actions live in its sidebar.
    -->
    <style name="Theme.Kaiwa" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/surface</item>
        <item name="colorPrimaryDark">@color/kaiwa_bg</item>
        <item name="colorAccent">@color/primary</item>
        <item name="alertDialogTheme">@style/Kaiwa.Dialog</item>
        <item name="android:alertDialogTheme">@style/Kaiwa.Dialog</item>

        <item name="android:windowBackground">@color/kaiwa_bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowContentOverlay">@null</item>

        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!--
        Every control in the right-hand column. The platform button is 88dp wide, carries
        a shadow and uppercases its label, none of which suits a 44dp column, so size,
        background, glyph colour and text case are all replaced here. The background
        selector is what draws the blue focus state the D-pad depends on.
    -->
    <style name="Kaiwa.Control" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:layout_marginRight">4dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_control</item>
        <item name="android:textColor">@color/control_glyph</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
        A full-width form button, for the screens that are not the chat.

        There is no primary variant: every button in the app is this grey chip, and blue
        means only that the D-pad has landed on one. Send is the exception to nothing -
        it is the same control as the scroll arrows beside it.
    -->
    <style name="Kaiwa.Button" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_control</item>
        <item name="android:textColor">@color/control_glyph</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
        The way out of a submenu: one glyph in a square chip, the same size as the sidebar's
        controls, because it shares its row with a title and that row is deliberately no
        taller than those controls.
    -->
    <style name="Kaiwa.Button.Back" parent="Kaiwa.Button">
        <item name="android:layout_width">@dimen/control_height</item>
        <item name="android:layout_height">@dimen/control_height</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
        One row of the Settings menu. A plain line carrying the shared row highlight rather
        than a chip: these are places to go, not things to do, and there are only three.
    -->
    <style name="Kaiwa.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
        The small quiet caption above a form field.

        parent="" is deliberate: a dotted style name otherwise implies a parent of
        "Kaiwa", and there is no such style. These are purely additive attribute sets.
    -->
    <style name="Kaiwa.FieldLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">5dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- A form field: the same rounded box as the message box, so the screen has one look. -->
    <style name="Kaiwa.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!--
        The dialog that confirms deleting a chat, which is AppCompat's rather than the app's,
        but still sits in the app's palette. Its buttons are the reason this exists: AppCompat
        colours them with the accent, which would leave them blue with nothing focused, against
        every other control in the app.
    -->
    <style name="Kaiwa.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:buttonBarButtonStyle">@style/Kaiwa.Dialog.Button</item>
        <item name="buttonBarButtonStyle">@style/Kaiwa.Dialog.Button</item>
    </style>

    <style name="Kaiwa.Dialog.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="android:textColor">@color/dialog_button_text</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
