<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice input. Dangerous permission, so it is asked for the first time the mic is pressed. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- The KYOCERA NP902KC has no touchscreen; the app must still install there. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        RECORD_AUDIO would otherwise imply that a microphone is a hard requirement.
        Voice input is one feature of the app rather than the point of it, so the app
        still installs on hardware without one - the mic reports the problem instead.
    -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!--
        Cleartext is permitted here because endpoint policy is decided at runtime by the
        imported config. The network-security-config is compiled into the APK and cannot
        change while the app runs, so ApiClient is the real gate: it refuses any http://
        URL unless that config sets "allowCleartext": true.
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaiwa"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            First run only. Not a launcher and not exported: MainActivity stays the entry
            point, and hands over to this one while nothing is configured yet.
        -->
        <activity
            android:name=".WelcomeActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:label="@string/app_name"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ChatListActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:label="@string/chat_list_title"
            android:screenOrientation="portrait" />

        <!-- The Settings menu: the three things that are not chatting. -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:label="@string/settings_title"
            android:screenOrientation="portrait" />

        <!--
            The API form, reached from the Settings menu. It is the one that wants the
            keyboard, hence the resize.
        -->
        <activity
            android:name=".ApiSettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:label="@string/api_settings_title"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Reached from the Settings menu: it is not something you reach for while chatting.
        -->
        <activity
            android:name=".AboutActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:exported="false"
            android:label="@string/about_title"
            android:screenOrientation="portrait" />
    </application>

</manifest>
